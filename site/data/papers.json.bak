 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_614",
  "title": "From Chat to Governed Analysis: Skill-Based AI Agents for Clinical Data Analytics",
  "authors": [
   "Weijie Zhang",
   "Xing Chen"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_614",
  "pdf_url": "",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Generative AI agents have strong potential in pharma analytics, but reliable deployment requires more than a conversational interface. Agents need access to domain-specific instructions, approved analytical workflows, validated plotting functions, and internal standards for interpretation and reporting. In this talk, we describe how we introduced a lightweight \"Agent Skills\" layer into an Ellmer-based agent. We implemented skill selection using tool/function calling with structured inputs. Each skill follows a common agent skill format with a YAML header and body content, giving the agent awareness of available capabilities while minimizing context usage. At runtime, the agent selects a skill name through structured input, and the corresponding full skill is dynamically loaded to guide analysis or execution. These skills are used to instruct the agent to perform analyses consistent with internal standards, call approved plotting functions, and generate structured outputs aligned with team expectations. We will share implementation details, practical lessons, and design considerations for building modular, governed, and extensible AI agents for pharma analytics using ellmer.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_615",
  "title": "Harnessing Generative AI to Improve Test Data Quality and Efficiency in Clinical Trial Set-Up",
  "authors": [
   "Rita Pecuch",
   "Varun Jagadeesh"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_615",
  "pdf_url": "https://youtu.be/NPFtY4LGG6I",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Generating and entering test data into electronic data capture (EDC) systems is a critical yet laborious task, essential for validating study designs and numerous downstream systems and programs. We previously leveraged open-source technology to develop a tool to significantly ease the time-intensive effort of manual test data entry and notable efficiency gains have been achieved since its release; however, it falls short in effectively covering the full spectrum of test cases necessary for clinical system set-up and programming. To overcome these challenges, Takeda has sought to build on this innovative software solution to harness the power of generative AI (GenAI) to expand the range of covered testing scenarios. During the development process, strategies and best practices for maximizing GenAI potential in the clinical test data context have been established, along with valuable lessons learned along the way. Exciting potential future directions have been identified to further reduce clinical trial system set-up times.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_616",
  "title": "Scheduled Clinical Insights: AI-Assisted Quarto Reporting for Oncology Studies",
  "authors": [
   "Matthew Kumar"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_616",
  "pdf_url": "https://youtu.be/NkLVLsI4LiY",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "In a previous effort, we developed a hybrid R Shiny application combining deterministic clinical visualizations with LLM-assisted exploration for early-phase oncology data review. This talk presents an alternative delivery mode we're exploring — an interactive, automated Quarto report generated and delivered daily to end users. The workflow, orchestrated through Posit Connect, queries updated study data, produces an abridged set of key outputs, applies LLM-assisted interpretation to static visualizations, and incorporates a lightweight RAG pipeline (via ragnar) to ground AI-generated insights in study context. We'll share the setup and practical lessons from this early-stage effort. The Shiny app remains primary, but this explores a scheduled, push-based complement for users whose needs are better met by a delivered report than an open-ended tool.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_617",
  "title": "Agentic AI Basics: How LLMs Work",
  "authors": [
   "Michael Rimler",
   "Mike Stackhouse"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_617",
  "pdf_url": "https://youtu.be/MpXyBePMNwc",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "AI is everywhere. No doubt that your organization is exploring how to integrate LLMs and GenAI into daily work. Now we have AI Agents and MCPs - the gap continues to widen between simple prompting in an LLM interface to fully automated agentic coding that can handle routine tasks end-to-end. This presentation will explore how one might help close that gap through a use-case scenario that was delivered as a hands-on workshop at the 2026 PHUSE US Connect in Austin, TX. The objective of the workshop was for participants to leave the session with (i) an understanding of the fundamental concepts of how LLMs and AI solutions operate, (ii) a sense of the ease of entry to get started with agentic coding and (iii) an appreciation for the effort required to engineer the initial \"first solution\" into a robust and stable ready-for-production solution.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_618",
  "title": "Use AI to build and share insights from health data",
  "authors": [
   "Garrett Grolemund",
   "Phil Bowsher"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "WS",
  "section_name": "Workshop",
  "paper_code": "RPharma-2026-rinpharma_618",
  "pdf_url": "https://youtu.be/cPjlQAmw6xU",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "This short workshop will show you how to enhance your productivity with AI. We will use the free Positron IDE and its integrated AI agents to build and share - Reports with Quarto. - Dashboards with Quarto. - Interactive apps with Shiny - AI powered apps with QueryChat We will learn how to share these on Posit Connect, where you can control access to your content, schedule automatic updates, monitor usage, and more. Together, these activities help demonstrate the benefit of using AI not simply to find answers, but to build auditable and reproducible code trails that generate answers.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_619",
  "title": "Break",
  "authors": [
   "NA"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "SC",
  "section_name": "Schedule only",
  "paper_code": "RPharma-2026-rinpharma_619",
  "pdf_url": "",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_620",
  "title": "Beyond the Prompt: Building Truly Autonomous AI Agents with MCP",
  "authors": [
   "Harshavardhan Bajoria"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_620",
  "pdf_url": "https://youtu.be/TFCUDn2EGEE",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Large Language Models are powerful, but they are often limited by \"stale\" knowledge. To move toward true Agentic Coding—where AI plans, executes, and iterates autonomously—we must provide them with real-time, high-fidelity context. The Model Context Protocol (MCP) provides the missing link. This session explores the technical \"Deep-Dive\" into MCP's primitives, including dynamic prompts and resource interpolation. We'll demonstrate how agents can now query GitHub issues, run tests, and fetch live documentation using natural language. Stop building isolated chatbots and start building integrated AI partners.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_621",
  "title": "Hands Dirty First: Practical Notes from Before, During, and After Building Agentic Workflows",
  "authors": [
   "Mia Chen"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_621",
  "pdf_url": "https://youtu.be/4CPkxc3Zz8I",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "2026 has been a banner year for AI and has pushed LLM capabilities across a new operational threshold that makes it practical for agents to execute structured workflows through explicit orchestration frameworks such as Claude Code, with task-specific guidance encoded in lightweight markdown artifacts such as skill files. In a biostatistical and clinical data context, this can facilitate tasks such as authoring statistical documentation and programming code, which in turn produce analysis datasets and outputs. In practice, however, building such workflows reliably raises substantial concerns around accuracy, evaluation, domain knowledge, GxP validation, data privacy, and human accountability. This presentation shares practical experience and reflections from building agentic workflows, organized in three parts early exploration, observations after diving in, and considerations for those preparing to do the same. Examples will be presented to illustrate the ideas.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_622",
  "title": "My Agents fought and became friends under 5 mins",
  "authors": [
   "Anannya Roy Chowdhury"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_622",
  "pdf_url": "https://youtu.be/XzPa-cA7aAE",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Open-source agents are easy to plug into workflows. Until they start disagreeing. Give one agent the task of retrieving clinical data, another for budget constraints, another for regulatory or submission checks—and ask a simple question generate a study-ready output. Watch them conflict, duplicate queries, and loop across tools. Tokens burn, latency spikes, and reproducibility—the thing pharma cares about most—starts to break. I'll demo this failure live. Then, in under 5 minutes, restructure the same system—introducing lightweight orchestration with Strands, clearer agent boundaries, and controlled interaction patterns. The same agents that were “fighting” now coordinate, share context, and produce consistent, auditable results in fewer steps and lower cost. The fix isn't more agents or better prompts. It's rethinking how agents interact in regulated, reproducible environments—what they own, how they communicate, and how their outputs can be trusted. The patterns emerging across open-source systems all point to the same idea agents don't need more autonomy—they need better coordination.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
