 {
  "id": "R-PHARMA-RPHARMA-2020-RINPHARMA_140",
  "title": "The R Validation Hub: Implementing a Risk-Based Approach to R",
  "authors": [
   "Andy Nicholls"
  ],
  "year": 2020,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2020-rinpharma_140",
  "pdf_url": "https://pharmar.github.io/rpharma2020_pres/",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "",
  "keywords": [],
