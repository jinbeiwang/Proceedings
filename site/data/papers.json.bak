 {
  "id": "R-PHARMA-RPHARMA-2022-RINPHARMA_304",
  "title": "Co-existence of R and SAS for multiple imputation in Novo Nordisk",
  "authors": [
   "Claus Dethlefsen"
  ],
  "year": 2022,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2022-rinpharma_304",
  "pdf_url": "https://youtu.be/gEg0hnC6nww",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Addressing estimands in clinical studies involves handling of intercurrent events and often multiple imputation methods are applied to handle missing data. In Novo Nordisk more and more programming tasks are done in R, but still multiple imputation methods are conducted using SAS. We look into the possibilities and obstacles of conducting multiple imputation using R and SAS interchangeably. The aim is to make it possible for the statisticians to choose between SAS and R based on either personal preferences or on which tool is best suited for the specific task. More specifically, the approach has been to simulate data, and to compare multiple imputation results from SAS (PROC MI and PROC MIANALYZE) to results from R (MICE package).",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
