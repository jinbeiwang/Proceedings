 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_610",
  "title": "Hands Dirty First: Practical Notes from Before, During, and After Building Agentic Workflows",
  "authors": [
   "Peng Zhang"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_610",
  "pdf_url": "https://youtu.be/s5JMeqBhrTE",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "2026 has been a banner year for AI and has pushed LLM capabilities across a new operational threshold that makes it practical for agents to execute structured workflows through explicit orchestration frameworks such as Claude Code, with task-specific guidance encoded in lightweight markdown artifacts such as skill files. In a biostatistical and clinical data context, this can facilitate tasks such as authoring statistical documentation and programming code, which in turn produce analysis datasets and outputs. In practice, however, building such workflows reliably raises substantial concerns around accuracy, evaluation, domain knowledge, GxP validation, data privacy, and human accountability. This presentation shares practical experience and reflections from building agentic workflows, organized in three parts early exploration, observations after diving in, and considerations for those preparing to do the same. Examples will be presented to illustrate the ideas.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_611",
  "title": "\"Ignore All Previous Instructions\" and Other Things Your LLM Shouldnt Do in Pharma: Applying GenAI Security Guardrails in R",
  "authors": [
   "Indraneel Chakraborty"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_611",
  "pdf_url": "https://youtu.be/L0S5ozizddM",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "As R users in pharma begin integrating LLMs into analytical and reporting workflows, a practical question keeps coming up how do we check what goes into the model and what comes back, in a way that is transparent, auditable, and fits into how we already work in R? This talk presents  llmshieldr , an open-source R package I've been developing as an attempt to fill that gap. It adds a transparent, model-agnostic guardrail layer that scans prompts, retrieved context, and model outputs before anything risky leaves or enters your workflow. The rule engine supports regex pattern matching, lightweight NLP intent detection, and optional semantic review using local LLMs, keeping sensitive data off third-party APIs entirely. Controls are mapped to the OWASP Top 10 for LLM Applications (2025), and every scan produces auditable findings with configurable policies and structured logging. I'll walk through the design with real examples, highlighting pharma-relevant scenarios. This is an experimental project, being built for open source. The goal is to share what's working, what's not, and start a conversation about what secure LLM usage in R focussed pharma teams should actually look like.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_612",
  "title": "Accelerating Population PK/PD Modeling and Simulation with GenAI",
  "authors": [
   "Husain Attarwala"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_612",
  "pdf_url": "https://youtu.be/Fn9PhtuXo90",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Generative AI is rapidly moving from novelty to utility in quantitative drug development. In this talk, I will present a live demo of how genAI can be applied to population PK modeling and simulation workflows in R, from data review and model coding to simulation, interpretation, and reporting. The session will highlight practical use cases where genAI can improve speed and consistency while keeping the pharmacometrician firmly in the loop. Attendees will leave with a grounded view of how genAI can be used today to augment pharmacometrics workflows in a reproducible and scientifically credible way.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
