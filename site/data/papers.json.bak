 },
 {
  "id": "R-PHARMA-RPHARMA-2024-RINPHARMA_492",
  "title": "Creating a Doctor Network using R and Graph Databases",
  "authors": [
   "Henri Defretin"
  ],
  "year": 2024,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
