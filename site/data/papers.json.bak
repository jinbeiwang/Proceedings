 },
 {
  "id": "R-PHARMA-RPHARMA-2020-RINPHARMA_158",
  "title": "safetyGraphics v2.0 - Open Source Collaboration in Pharma using R and Shiny",
  "authors": [
   "Jeremy Wildfire"
  ],
  "year": 2020,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2020-rinpharma_158",
  "pdf_url": "",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "The visR project for effective graphics in drug development visR is an open collaborative effort to develop solutions for effective visual communication with a focus on reporting medical and clinical data. The aim of the collaboration is to develop a user-friendly, fit for purpose, open source package to simplify the use of good graphical principles for effective visual communication of typical analyses of interventional and observational data encountered in clinical drug development.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
