 {
  "id": "R-PHARMA-RPHARMA-2024-RINPHARMA_384",
  "title": "Kick-off & Hands-on Session: GenAI to Enhance Your Statistical Programming",
  "authors": [
   "Phil Bowsher",
   "Cole Arendt"
  ],
  "year": 2024,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "WS",
  "section_name": "Workshop",
  "paper_code": "RPharma-2024-rinpharma_384",
  "pdf_url": "https://youtu.be/ysTSmxB5piY",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Posit/RStudio will be providing a hands-on session on using AI to enhance open-source statistical programming. This session will discuss opportunities and applications for AI to empower statistical programmers. This talk will explore and discuss GenAI to support programmers in the process of writing code and provide a hands-on opportunity to test it out.",
