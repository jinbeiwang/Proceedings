 {
  "id": "R-PHARMA-RPHARMA-2020-RINPHARMA_184",
  "title": "Its a trap! A data science case story",
  "authors": [
   "Leon Eyrich Jessen"
  ],
  "year": 2020,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2020-rinpharma_184",
  "pdf_url": "https://rpubs.com/leonjessen/rpharma2020",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Predictive modeling is a powerful tool, which amongst other things can be applied for prioritising drug candidates. Limiting the search space needed for target exploration, can reduce costs markedly partly eliminating lab time and expensive kits. Predictive modeling is however not without pitfalls... In this short talk, I will present a (fictive) data science case story, outlining one major challenge in predictive modeling, while demonstrating how to address said challenge.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2020-RINPHARMA_185",
  "title": "X-Omics Platform",
