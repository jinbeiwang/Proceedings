 {
  "id": "R-PHARMA-RPHARMA-2021-RINPHARMA_219",
  "title": "Survival analysis with tidymodels: The censored package",
  "authors": [
   "Max Kuhn",
   "Hannah Frick"
  ],
  "year": 2021,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2021-rinpharma_219",
  "pdf_url": "https://youtu.be/orAlJ321hOc",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Tidymodels has begun to create tools for modeling event time data. This will include methods for fitting, resampling, and characterizing models with censored outcomes. This talk will describe our design goals, show some syntax for modeling, and describe subsequent additions to tidymodels.",
