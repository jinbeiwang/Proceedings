 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_605",
  "title": "Using LLMs to generate Teal applications: from proof of concept to production",
  "authors": [
   "Nikolas Burkoff"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_605",
  "pdf_url": "https://youtu.be/Q8pwUUELlkc",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Large language models (LLMs) can accelerate code generation, making it easier to build proof-of-concept tools and solutions. For example, building R Shiny applications using the Teal framework for clinical data visualisation. However, moving from AI experts building proof-of-concept applications to Statistical Programmers using these tools to build production applications introduces significant challenges. Applications are often highly customised and complex, and their development requires a detailed understanding of specific clinical data, the programming environment, and the company's wider processes. Developers may also be new to AI-assisted coding and the Teal framework. In this presentation, we will discuss these challenges and share how Johnson & Johnson is addressing them to scale adoption of Teal applications and AI-assisted programming, enabling statistical programmers to harness LLMs effectively in their day-to-day work.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_606",
  "title": "Skils 101",
  "authors": [
   "Isabella Velásquez"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_606",
  "pdf_url": "https://youtu.be/MphOm5LDhi8",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Throughout this conference, you're going to hear the word \"skill\" a lot. These specifically mean \"agent skills\", specialized tools and behaviors passed to large language models to make them actionable. If you've found yourself wondering, \"What actually is a skill?\"\" then join us for Skills 101. We'll break down what they are, what they are not, and how they work, giving you the foundational toolkit to navigate the rest of the conference.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_607",
  "title": "From R, Shiny, and Container to AI Skills: The R Consortium Submissions Working Group Call for Contributors",
  "authors": [
   "Eric Zhang",
   "Ning Leng"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_607",
  "pdf_url": "https://youtu.be/cMsgD20TW-8",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "The R Consortium Submission Working Group has spent the past several years putting modernized components through FDA pilots - R, containers, Shiny, WebAssembly, JSON - demonstrating that open-source tooling can meet regulated-submission standards. Through that work, one limitation kept surfacing benchmark data. The CDISC SDTM/ADaM Pilot 1 dataset, our de facto test bed for every new technology component, is now nearly two decades old and narrow in scope. When we turned to AI skills for specialized statistical tasks, the gap became acute - there were not enough benchmark test cases for these workflows. Pilot 7 is our response. It has two parts build modern, varied benchmark clinical trial data for general tooling, and crowdsource benchmark test cases for pharma-skills, an open-source library of AI skills developed jointly with Bay area Biotech-Pharma Statistics Workshop (BBSW). The first skill we open-sourced is Group Sequential Design, built on gsDesign, gsDesign2, graphicalMCP with lrstat Monte Carlo verification and a JSON-driven Word report (https//github.com/RConsortium/pharma-skills). To evaluate the skill, we aim to develop test cases that cover both typical scenarios and edge cases, helping us understand its limits across different AI agents. One week since release, the community has contributed 10+ benchmark test cases. We'd love more — especially the tough ones that stretch the skill. Submitting takes about 15 minutes on GitHub and no coding required describe a design scenario, state the expected output, write objective rubric criteria. Each case you share helps shape how AI shows up in our field, built by the statisticians who know the work best.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
  "id": "R-PHARMA-RPHARMA-2026-RINPHARMA_608",
  "title": "R/Pharma Hangout: Shinymcp",
  "authors": [
   "James Wade"
  ],
  "year": 2026,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "TK",
  "section_name": "Talk",
  "paper_code": "RPharma-2026-rinpharma_608",
  "pdf_url": "https://youtu.be/M5UUuBWJ6h4",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "Shiny is a proven way to build interactive data applications, but a Shiny app lives behind a URL. As AI assistants become a common place to explore and analyze data, that separation means users leave the conversation to use the app, then carry the results back by hand. In this edition of the R/Pharma Hangout sessions, James Wade (Dow) demonstrates [ shinymcp ](https//jameshwade.github.io/shinymcp/), which converts Shiny apps into MCP-compatible interfaces that render inside chat-based tools. Plots, inputs, and summaries appear inline, respond to user input, and execute code within the conversation ([background post](https//jameshwade.com/posts/2026-02-21_shinymcp.html)). The session also covers two related packages built on ellmer  dsprrr , which brings DSPy-style signatures, optimization, and tracing to R so prompts can be improved with data instead of hand-tuning, and  deputy , an agent runtime for building tool-using AI agents with permissions, hooks, and multi-agent coordination. Together, these tools treat Shiny components as building blocks for agent-connected workflows rather than standalone dashboards.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
 {
