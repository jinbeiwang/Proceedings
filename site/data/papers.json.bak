 {
  "id": "R-PHARMA-RPHARMA-2022-RINPHARMA_301",
  "title": "BioTech Challenges",
  "authors": [
   "Robert Gentleman"
  ],
  "year": 2022,
  "conference": "r-pharma",
  "conference_name": "R/Pharma",
  "section_code": "KN",
  "section_name": "Keynote",
  "paper_code": "RPharma-2022-rinpharma_301",
  "pdf_url": "https://youtu.be/32QXE0PKVdM",
  "source_url": "https://rinpharma.github.io/data-pipelines/output/processed_talks.csv",
  "abstract": "I will talk about some of the challenges that are now arising in BioTech.  There are larger, more informative but much more complex, data sets available and being developed.  While these hold great promise they add complexity to an already fragile analytic environment.  I will divide the challenges into three groups, software, data technologies and analytics and provide some examples of how we can increase sharing and reduce complexity.  I will also argue that the funding of data resources and technologies, whether government or private, needs to adapt to the changing landscape and provide some suggestions of how that could happen.",
  "keywords": [],
  "lang": "en",
  "region": "Global",
  "added_at": "2026-08-06T08:04:34+00:00"
 },
